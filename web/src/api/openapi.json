  "components": {
    "schemas": {
      "AuthModeResponse": {
        "required": [
          "mode"
        ],
        "type": "object",
        "properties": {
          "mode": {
            "type": "string"
          }
        }
      },
      "CapabilityChange": {
        "required": [
          "kind",
          "code",
          "before",
          "after"
        ],
        "type": "object",
        "properties": {
          "kind": {
            "$ref": "#/components/schemas/CapabilityChangeKind"
          },
          "code": {
            "type": "string"
          },
          "before": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/CapabilitySnapshot"
              }
            ]
          },
          "after": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/CapabilitySnapshot"
              }
            ]
          }
        }
      },
      "CapabilityChangeKind": {
        "enum": [
          "Ny",
          "Aendret",
          "Slettes"
        ]
      },
      "CapabilityImportResult": {
        "required": [
          "committed",
          "errors",
          "summary",
          "changes",
          "fingerprint"
        ],
        "type": "object",
        "properties": {
          "committed": {
            "type": "boolean"
          },
          "errors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ImportRowError"
            }
          },
          "summary": {
            "$ref": "#/components/schemas/CapabilityImportSummary"
          },
          "changes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CapabilityChange"
            }
          },
          "fingerprint": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "CapabilityImportSummary": {
        "required": [
          "new",
          "changed",
          "removed",
          "unchanged",
          "currentTotal",
          "largeRemoval"
        ],
        "type": "object",
        "properties": {
          "new": {
            "type": "integer",
            "format": "int32"
          },
          "changed": {
            "type": "integer",
            "format": "int32"
          },
          "removed": {
            "type": "integer",
            "format": "int32"
          },
          "unchanged": {
            "type": "integer",
            "format": "int32"
          },
          "currentTotal": {
            "type": "integer",
            "format": "int32"
          },
          "largeRemoval": {
            "type": "boolean"
          }
        }
      },
      "CapabilityNode": {
        "required": [
          "id",
          "code",
          "name",
          "description",
          "parentId",
          "depth"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "code": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": [
              "null",
              "string"
            ]
          },
          "parentId": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          },
          "depth": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "CapabilitySnapshot": {
        "required": [
          "code",
          "name",
          "parentCode",
          "description"
        ],
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "parentCode": {
            "type": [
              "null",
              "string"
            ]
          },
          "description": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "CapabilityTreeResponse": {
        "required": [
          "items",
          "canImport"
        ],
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CapabilityNode"
            }
          },
          "canImport": {
            "type": "boolean"
          }
        }
      },
      "ConfirmSystemRequest": {
        "required": [
          "version"
        ],
        "type": "object",
        "properties": {
          "version": {
            "type": [
              "null",
              "integer"
            ],
            "format": "uint32"
          }
        }
      },
      "CreateDataObjectRequest": {
        "required": [
          "name"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "CreatePersonRequest": {
        "required": [
          "displayName",
          "email",
          "department"
        ],
        "type": "object",
        "properties": {
          "displayName": {
            "type": [
              "null",
              "string"
            ]
          },
          "email": {
            "type": [
              "null",
              "string"
            ]
          },
          "department": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "DataObjectDto": {
        "required": [
          "id",
          "name"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "DevTokenRequest": {
        "required": [
          "userId"
        ],
        "type": "object",
        "properties": {
          "userId": {
            "type": "string"
          }
        }
      },
      "DevTokenResponse": {
        "required": [
          "accessToken"
        ],
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          }
        }
      },
      "DevUserResponse": {
        "required": [
          "id",
          "name",
          "roles"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "HttpValidationProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
